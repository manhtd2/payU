# Arc Testnet RPC (see foundry.toml [rpc_endpoints])
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Optional: only needed if verifying via an Etherscan-compatible API on arcscan
ARCSCAN_API_KEY=

# Deployment signing: prefer a keystore over a plaintext key for anything beyond local anvil.
#   cast wallet import payu-deployer --interactive
#   forge script script/Deploy.s.sol --rpc-url arc_testnet --account payu-deployer --sender <address> --broadcast
# PRIVATE_KEY below is for LOCAL ANVIL TESTING ONLY — never set this for a real deployment.
# PRIVATE_KEY=
