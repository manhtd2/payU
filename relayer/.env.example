# Arc Testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Deployed contract (fill in after `forge script script/Deploy.s.sol ... --broadcast`)
STREAM_MANAGER_ADDRESS=

# Relayer hot wallet — this key submits withdrawFor transactions and pays gas in USDC.
# Fund it with a small, replenishable amount of testnet USDC only. Never commit this file.
RELAYER_PRIVATE_KEY=

# Must be <= the on-chain MAX_GAS_FEE (0.05 USDC = 50000, 6 decimals). Keep some margin below it.
DEFAULT_GAS_FEE_MICRO_USDC=1000

PORT=8787
